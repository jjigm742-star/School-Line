# REQUIRED. PostgreSQL is the only authoritative runtime store.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Optional: only set when your provider needs an explicit override.
# SCHOOL_LINE_DATABASE_SSL=require
# SCHOOL_LINE_DATABASE_SSL=disable

# Optional tuning
# SCHOOL_LINE_DB_POOL_MAX=5
# SCHOOL_LINE_PERSIST_RETRY_MS=3000

# Optional inbound WebSocket limits (default 64 KiB/frame, 256 KiB/buffer).
# SCHOOL_LINE_MAX_WS_INBOUND_FRAME_BYTES=65536
# SCHOOL_LINE_MAX_WS_INBOUND_BUFFER_BYTES=262144
